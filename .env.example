# Copy this file to .env and fill in what you have. Every value below is
# optional -- with nothing set, the app runs end to end in mock mode (see
# backend/app/llm.py). Never commit the real .env file.

# Anthropic API key for fact extraction and risk-grading calls.
# Blank -> AI drafting runs in mock mode: extraction returns the raw
# document text for you to fill in by hand, and grading is not attempted.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

ENVIRONMENT=development
PORT=8000
